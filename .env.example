# Copia este archivo como .env y ajusta los valores.
APP_NAME="Sistema de Torneos"
ENVIRONMENT=development
DEBUG=false

# Base de datos (coincide con docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://torneos:torneos@localhost:5432/torneos
DATABASE_ECHO=false

# Usada solo por los tests (por defecto: base torneos_test local)
# TEST_DATABASE_URL=postgresql+asyncpg://torneos:torneos@localhost:5432/torneos_test
